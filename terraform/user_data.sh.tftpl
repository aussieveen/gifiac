#!/usr/bin/env bash
# First-boot bootstrap for the gifiac EC2 instance (SPEC-CLOUD.md §10).
# Amazon Linux 2023's own repos don't ship the Docker Compose plugin, so
# it's installed directly from the released binary (the standard
# cross-distro method) rather than via a package.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# `uname -m` happens to match docker/compose's own release-asset naming
# exactly (x86_64 / aarch64), so no translation table needed — this also
# makes the download arch-correct now that the instance is arm64
# (COST-REDUCTION-PLAN.md step 3; it was hardcoded to x86_64 before).
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# t4g.micro has only 1GiB RAM — a swap file as a safety net against
# ffmpeg export OOMs (COST-REDUCTION-PLAN.md step 3's open risk), not a
# performance feature. 2GiB chosen arbitrarily as "bigger than RAM";
# revisit if real exports still OOM with this in place.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

mkdir -p /opt/gifiac/data
cd /opt/gifiac

cat > docker-compose.yml <<'GIFIAC_COMPOSE_EOF'
${docker_compose_yml}
GIFIAC_COMPOSE_EOF

cat > Caddyfile <<'GIFIAC_CADDYFILE_EOF'
${caddyfile}
GIFIAC_CADDYFILE_EOF

# Non-secret config, baked in at instance creation — genuine secrets
# (SPEC-CLOUD.md §10) are fetched from SSM by deploy.sh instead, on every
# deploy, not just this first boot. Every value is double-quoted: deploy.sh
# `source`s this file as a bash script, so an unquoted value containing
# shell metacharacters (EMAIL_FROM_ADDRESS's "Name <addr>" form has `<`/`>`,
# read as redirection) breaks the source on a syntax error rather than
# just setting the variable.
cat > config.env <<EOF
R2_ACCOUNT_ID="${r2_account_id}"
R2_BUCKET_NAME="${r2_bucket_name}"
R2_PUBLIC_BASE_URL="${r2_public_base_url}"
GOOGLE_CLIENT_ID="${google_client_id}"
APP_BASE_URL="${app_base_url}"
SOURCE_VIDEOS_S3_BUCKET="${source_videos_s3_bucket}"
SOURCE_VIDEOS_S3_REGION="${source_videos_s3_region}"
TEMPLATE_ASSETS_S3_BUCKET="${template_assets_s3_bucket}"
TEMPLATE_ASSETS_S3_REGION="${template_assets_s3_region}"
EMAIL_FROM_ADDRESS="${email_from_address}"
SES_REGION="${ses_region}"
TURNSTILE_SITE_KEY="${turnstile_site_key}"
TRUST_CF_CONNECTING_IP="${trust_cf_connecting_ip}"
INGEST_LAMBDA_FUNCTION_NAME="${ingest_lambda_function_name}"
EXPORT_LAMBDA_FUNCTION_NAME="${export_lambda_function_name}"
CALLBACK_BASE_URL="${callback_base_url}"
EOF
chmod 600 config.env

cat > deploy.sh <<'GIFIAC_DEPLOY_EOF'
${deploy_sh}
GIFIAC_DEPLOY_EOF
chmod +x deploy.sh

./deploy.sh
