#!/usr/bin/env bash
# First-boot bootstrap for the gifiac EC2 instance (SPEC-CLOUD.md §10).
# Amazon Linux 2023's own repos don't ship the Docker Compose plugin, so
# it's installed directly from the released binary (the standard
# cross-distro method) rather than via a package.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# `uname -m` happens to match docker/compose's own release-asset naming
# exactly (x86_64 / aarch64), so no translation table needed — this also
# makes the download arch-correct now that the instance is arm64
# (COST-REDUCTION-PLAN.md step 3; it was hardcoded to x86_64 before).
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# t4g.micro has only 1GiB RAM — a swap file as a safety net against
# ffmpeg export OOMs (COST-REDUCTION-PLAN.md step 3's open risk), not a
# performance feature. 2GiB chosen arbitrarily as "bigger than RAM";
# revisit if real exports still OOM with this in place.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

mkdir -p /opt/gifiac/data
cd /opt/gifiac

cat > docker-compose.yml <<'GIFIAC_COMPOSE_EOF'
${docker_compose_yml}
GIFIAC_COMPOSE_EOF

cat > Caddyfile <<'GIFIAC_CADDYFILE_EOF'
${caddyfile}
GIFIAC_CADDYFILE_EOF

# Non-secret config, baked in at instance creation — genuine secrets
# (SPEC-CLOUD.md §10) are fetched from SSM by deploy.sh instead, on every
# deploy, not just this first boot. Rendered once in ec2.tf from
# config.env.tftpl and passed in as one pre-rendered blob (`config_env`)
# rather than interpolated field-by-field here, so the exact same
# rendered content can also be pushed to an *already-running* instance
# by `null_resource.push_config_env` (ec2.tf) whenever it changes —
# `user_data` only ever runs at first boot, so without that second path
# a config.env edit would silently never reach an existing instance (see
# that resource's comment for why this matters).
cat > config.env <<'GIFIAC_CONFIG_ENV_EOF'
${config_env}
GIFIAC_CONFIG_ENV_EOF
chmod 600 config.env

cat > deploy.sh <<'GIFIAC_DEPLOY_EOF'
${deploy_sh}
GIFIAC_DEPLOY_EOF
chmod +x deploy.sh

./deploy.sh
