# Copy this to .env (never committed — see .gitignore) and fill in real
# values. Used by docker-compose.yml to supply DB/R2 credentials to the
# container at start; nothing here is baked into the image itself.

DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=
SOURCE_VIDEOS_S3_ACCESS_KEY_ID=
SOURCE_VIDEOS_S3_SECRET_ACCESS_KEY=
SOURCE_VIDEOS_S3_BUCKET=
SOURCE_VIDEOS_S3_REGION=
TEMPLATE_ASSETS_S3_BUCKET=
TEMPLATE_ASSETS_S3_REGION=

# Email one-time-passcode login (SPEC-EMAIL-AUTH.md). LOGIN_CODE_HMAC_KEY
# must be at least 32 bytes, base64-encoded (e.g. `openssl rand -base64
# 32`). MAILER defaults to "log" (prints the code instead of sending it) —
# set to "ses" in production, which then requires EMAIL_FROM_ADDRESS and
# SES_REGION too. TURNSTILE_SECRET_KEY/TURNSTILE_SITE_KEY are optional —
# unset skips Turnstile verification entirely (local dev/test only; never
# leave it unset in production).
LOGIN_CODE_HMAC_KEY=
MAILER=
EMAIL_FROM_ADDRESS=
SES_REGION=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TRUST_CF_CONNECTING_IP=
