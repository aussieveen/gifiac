# Copy this to .env (never committed — see .gitignore) and fill in real
# values. Used by docker-compose.yml to supply R2 credentials to the
# container at start; nothing here is baked into the image itself.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
